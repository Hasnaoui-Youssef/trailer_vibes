@startuml
skinparam shadowing false
skinparam defaultFontName "Sans Serif"
skinparam backgroundColor white
skinparam sequenceArrowColor #333

title Thread Confinement via Command Queue

participant "Caller Thread" as CT
participant "ProbeProvider" as PP
participant "CommandQueue" as CQ
participant "Server Thread" as ST
participant "Probe C API" as API

CT -> PP : ReadMemory(address, size)
activate PP
PP -> CQ : Post(read lambda)
activate CQ
CQ -> CQ : enqueue task
CQ -> ST : wake
CQ --> PP : future
deactivate CQ
PP -> PP : wait on future\n(with timeout)

ST -> ST : drain queue
activate ST
ST -> API : execute read
activate API
API --> ST : raw bytes
deactivate API
ST -> ST : fulfill promise
deactivate ST

PP --> CT : result
deactivate PP

note over CQ
  The command queue
  serializes all operations
  onto the single server thread.
  No caller ever touches the
  probe API directly.
end note
@enduml
