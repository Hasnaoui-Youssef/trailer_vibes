@startuml
skinparam shadowing false
skinparam defaultFontName "Sans Serif"
skinparam backgroundColor white
skinparam sequenceArrowColor #333

title Domain Event Flow

participant "ComponentManager" as CM
participant "EventBus" as EB
participant "Session" as S
participant "Orchestrator" as O
participant "Frontend" as F

CM -> EB : Publish(domain event)
activate EB
EB -> S : notify subscriber
activate S
S -> S : translate domain\nevent to protocol event
S -> O : Send(protocol event)
activate O
O -> F : DAP event
deactivate O
deactivate S
deactivate EB

note over EB
  Domain events carry
  typed domain data.
  The Session performs
  the only domain-to-
  protocol translation.
end note
@enduml
